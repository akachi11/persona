# Address printed by the deploy script
NEXT_PUBLIC_PERSONA_CONTRACT=

# Free project ID from https://dashboard.reown.com (needed for Trust Wallet mobile / WalletConnect QR).
# Browser-extension wallets (MetaMask, Trust Wallet extension, Coinbase Wallet) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# true = use a local Hardhat node (no faucet needed), false = Base Sepolia testnet
NEXT_PUBLIC_USE_LOCAL_CHAIN=true
